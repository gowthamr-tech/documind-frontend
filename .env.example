# Copy to .env.local for local runs. Never commit real values.
# All variables are read server-side only (by the BFF route handlers) and validated at first use
# (src/lib/server/env.ts) — the app refuses to serve requests with invalid configuration.

# Base URL of the DocuMind backend (without /api/v1). Required when NODE_ENV=production.
DOCUMIND_API_URL=http://localhost:8000

# Max wait for the backend's response headers, in ms (SSE streams may run longer). Default 30000.
# DOCUMIND_UPSTREAM_TIMEOUT_MS=30000

# Max request body the BFF buffers, in bytes (backend upload limit is 50 MB). Default 53477376.
# DOCUMIND_MAX_BODY_BYTES=53477376
